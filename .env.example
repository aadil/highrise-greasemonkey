# Anthropic API key for AI-powered reel suggestions
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP settings for email alerts
# To use Gmail, enable "App Passwords" in your Google Account:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an app password for "Mail"
# 3. Use that 16-character password below
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ALERT_RECIPIENT=your-email@gmail.com

# How often to scan (in minutes). Default: 30
SCAN_INTERVAL_MINUTES=30

# Server port for the dashboard
PORT=3000

# Optional: Set to "true" to send email on every scan even if no new articles
# Default: only sends email when new articles are found
ALWAYS_SEND_EMAIL=false
